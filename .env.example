# Copy to .env (or run `make env` to generate random secrets). NEVER commit .env.
ENVIRONMENT=development
# Swagger UI at /api/docs; set false on internet-facing deployments
API_DOCS_ENABLED=true
HTTPS_PORT=8443
# 127.0.0.1 = only this computer can open the console; 0.0.0.0 = reachable from the network
BIND_ADDRESS=127.0.0.1
# Origins allowed to serve external HLS feeds to the browser (Content-Security-Policy)
EXTERNAL_MEDIA_ORIGINS=https://test-streams.mux.dev
# set to your domain in production
SITE_ADDRESS=localhost
# production: your ACME email, e.g. ops@example.com
TLS_MODE=internal

# Data stores
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
REDIS_PASSWORD=change-me

# Security
JWT_SECRET=change-me-to-at-least-32-random-characters
# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=
# Authenticates the backend to the video gateway control API
GATEWAY_API_SECRET=change-me

# Bootstrap accounts (users: admin / operator / viewer)
ADMIN_PASSWORD=change-me
OPERATOR_PASSWORD=change-me
VIEWER_PASSWORD=change-me

# Machine identity used by the simulators (X-API-Key)
SEED_API_KEY=ntr_change-me

# Simulated camera-side credentials
CAMSIM_PASSWORD=change-me
ONVIF_PASSWORD=change-me
VENDOR_API_KEY=change-me

# Simulator
# http | stream | mixed
INGEST_MODE=mixed
SIM_EVENTS_PER_MIN=20
PUBLIC_HLS_URL=https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8

# Production server (set automatically by scripts/deploy-vm.sh)
PUBLIC_IP=
